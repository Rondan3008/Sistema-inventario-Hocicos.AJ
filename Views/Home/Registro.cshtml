@model RegistroClienteViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="container mt-4 auth-page">
    <header class="page-heading">
        <p class="page-eyebrow">TU CUENTA</p>
        <h1>Crear cuenta de cliente</h1>
        <p>Regístrate para guardar productos en tu carrito y consultar tus compras.</p>
    </header>

    <form asp-controller="Home" asp-action="Registro" method="post" asp-antiforgery="true" class="form-panel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre completo</label>
            <input asp-for="Nombre" class="form-control" autocomplete="name" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Usuario" class="form-label">Usuario</label>
            <input asp-for="Usuario" class="form-control" autocomplete="username" />
            <span asp-validation-for="Usuario" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Correo" class="form-label">Correo (opcional)</label>
            <input asp-for="Correo" class="form-control" autocomplete="email" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Contraseña" class="form-label">Contraseña</label>
            <input asp-for="Contraseña" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Contraseña" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmarContraseña" class="form-label">Confirmar contraseña</label>
            <input asp-for="ConfirmarContraseña" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarContraseña" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2 pt-2">
            <button type="submit" class="btn btn-primary">Crear cuenta</button>
            <a asp-action="AccesoAdmin" class="btn btn-secondary">Ya tengo una cuenta</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
