@model AdminPersonalizacionViewModel

@{
    ViewData["Title"] = "Personalización de la tienda";
    var allowedPaths = new[]
    {
        new { Value = "/Productos", Text = "Catálogo de productos" },
        new { Value = "/Carrito", Text = "Carrito" },
        new { Value = "/Home/Registro", Text = "Registro de clientes" }
    };
}

<section class="admin-personalization">
    <p>Administra textos e imágenes. Los cambios se guardan en archivos persistentes fuera del contenido publicable; no se modifica MySQL.</p>
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }
    <form asp-action="Index" method="post" enctype="multipart/form-data" asp-antiforgery="true">
        <input asp-for="Version" type="hidden" />
        <input asp-for="LogoImagePath" type="hidden" />
        <input asp-for="HeroImagePath" type="hidden" />
        <input asp-for="DashboardImagePath" type="hidden" />

        <div class="row g-4">
            <div class="col-xl-7">
                <section class="admin-panel-card mb-4" aria-labelledby="hero-settings-title">
                    <h2 id="hero-settings-title">Banner principal</h2>
                    <div class="mb-3">
                        <label asp-for="HeroTitle" class="form-label">Título</label>
                        <input asp-for="HeroTitle" class="form-control" data-live-preview="hero-title" />
                        <span asp-validation-for="HeroTitle" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="HeroSubtitle" class="form-label">Subtítulo</label>
                        <textarea asp-for="HeroSubtitle" class="form-control" data-live-preview="hero-subtitle"></textarea>
                        <span asp-validation-for="HeroSubtitle" class="text-danger"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HeroButtonText" class="form-label">Texto del botón</label>
                            <input asp-for="HeroButtonText" class="form-control" data-live-preview="hero-button" />
                            <span asp-validation-for="HeroButtonText" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HeroButtonPath" class="form-label">Destino</label>
                            <select asp-for="HeroButtonPath" class="form-select">
                                @foreach (var path in allowedPaths)
                                {
                                    <option value="@path.Value">@path.Text</option>
                                }
                            </select>
                            <span asp-validation-for="HeroButtonPath" class="text-danger"></span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.HeroImagePath) && Url.IsLocalUrl(Model.HeroImagePath))
                    {
                        <img src="@Model.HeroImagePath" class="admin-image-preview mb-3" alt="Banner principal actual" data-image-preview="hero" />
                    }
                    else
                    {
                        <div class="admin-image-preview-placeholder mb-3" data-image-preview="hero">Sin imagen personalizada</div>
                    }
                    <div class="mb-3">
                        <label asp-for="HeroFile" class="form-label">Subir o reemplazar imagen</label>
                        <input asp-for="HeroFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control" data-image-input="hero" />
                    </div>
                    <div class="form-check">
                        <input asp-for="RemoveHeroImage" class="form-check-input" />
                        <label asp-for="RemoveHeroImage" class="form-check-label">Usar el espacio visual predeterminado</label>
                    </div>
                </section>

                <section class="admin-panel-card mb-4" aria-labelledby="text-settings-title">
                    <h2 id="text-settings-title">Textos de secciones</h2>
                    <div class="mb-3">
                        <label asp-for="CategoriesTitle" class="form-label">Título de categorías</label>
                    <input asp-for="CategoriesTitle" class="form-control" data-live-preview="categories-title" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FeaturedTitle" class="form-label">Título de productos</label>
                    <input asp-for="FeaturedTitle" class="form-control" data-live-preview="featured-title" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="InformationTitle" class="form-label">Título informativo</label>
                    <input asp-for="InformationTitle" class="form-control" data-live-preview="information-title" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="InformationText" class="form-label">Texto informativo</label>
                    <textarea asp-for="InformationText" class="form-control" data-live-preview="information-text"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FooterText" class="form-label">Texto del pie de página</label>
                    <input asp-for="FooterText" class="form-control" data-live-preview="footer-text" />
                    </div>
                </section>

                <section class="admin-panel-card mb-4" aria-labelledby="banner-settings-title">
                    <h2 id="banner-settings-title">Banners secundarios</h2>
                    <p class="text-muted">Los espacios desactivados no se muestran en la tienda.</p>
                    @for (var index = 0; index < Model.Banners.Count; index++)
                    {
                        <fieldset class="banner-editor">
                            <legend>Banner @(index + 1)</legend>
                            <input asp-for="Banners[index].ImagePath" type="hidden" />
                            <div class="form-check mb-3">
                                <input asp-for="Banners[index].IsActive" class="form-check-input" data-banner-active="@index" />
                                <label asp-for="Banners[index].IsActive" class="form-check-label">Mostrar este banner</label>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Banners[index].Title" class="form-label">Título</label>
                                <input asp-for="Banners[index].Title" class="form-control" data-live-preview="banner-@(index)-title" />
                                <span asp-validation-for="Banners[index].Title" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Banners[index].Text" class="form-label">Texto</label>
                                <textarea asp-for="Banners[index].Text" class="form-control" data-live-preview="banner-@(index)-text"></textarea>
                                <span asp-validation-for="Banners[index].Text" class="text-danger"></span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Banners[index].ButtonText" class="form-label">Texto del botón (opcional)</label>
                                    <input asp-for="Banners[index].ButtonText" class="form-control" data-live-preview="banner-@(index)-button" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Banners[index].ButtonPath" class="form-label">Destino local</label>
                                    <select asp-for="Banners[index].ButtonPath" class="form-select">
                                        @foreach (var path in allowedPaths)
                                        {
                                            <option value="@path.Value">@path.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Banners[index].ImagePath) && Url.IsLocalUrl(Model.Banners[index].ImagePath))
                            {
                                <img src="@Model.Banners[index].ImagePath" class="admin-image-preview mb-3" alt="Imagen del banner @(index + 1)" data-preview-image="banner-@index" />
                            }
                            else
                            {
                                <div class="admin-image-preview-placeholder mb-3" data-preview-image="banner-@index">Sin imagen personalizada</div>
                            }
                            <div class="mb-3">
                                <label asp-for="Banners[index].ImageFile" class="form-label">Imagen</label>
                                <input asp-for="Banners[index].ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control" data-image-input="banner-@index" />
                            </div>
                            <div class="form-check">
                                <input asp-for="Banners[index].RemoveImage" class="form-check-input" />
                                <label asp-for="Banners[index].RemoveImage" class="form-check-label">Quitar imagen</label>
                            </div>
                        </fieldset>
                    }
                </section>
            </div>

            <div class="col-xl-5">
                <section class="admin-panel-card mb-4" aria-labelledby="preview-title">
                    <h2 id="preview-title">Previsualización</h2>
                    <div class="personalization-preview">
                        <p class="page-eyebrow">HOCICOS A.J. · TIENDA PARA PERROS</p>
                        <h3 data-preview-target="hero-title">@Model.HeroTitle</h3>
                        <p data-preview-target="hero-subtitle">@Model.HeroSubtitle</p>
                        <span class="btn btn-primary" data-preview-target="hero-button">@Model.HeroButtonText</span>
                        <div class="preview-section">
                            <h4 data-preview-target="categories-title">@Model.CategoriesTitle</h4>
                            <h4 data-preview-target="featured-title">@Model.FeaturedTitle</h4>
                            <h4 data-preview-target="information-title">@Model.InformationTitle</h4>
                            <p data-preview-target="information-text">@Model.InformationText</p>
                            <footer data-preview-target="footer-text">@Model.FooterText</footer>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.HeroImagePath) && Url.IsLocalUrl(Model.HeroImagePath))
                        {
                            <img src="@Model.HeroImagePath" class="admin-image-preview mt-3" alt="Previsualización del banner" data-preview-image="hero" />
                        }
                        else
                        {
                            <div class="admin-image-preview-placeholder mt-3" data-preview-image="hero">Espacio del banner</div>
                        }
                    </div>
                    <div class="banner-preview-list">
                        @for (var index = 0; index < Model.Banners.Count; index++)
                        {
                            <article class="storefront-banner__copy" data-banner-preview="@index">
                                <h4 data-preview-target="banner-@(index)-title">@Model.Banners[index].Title</h4>
                                <p data-preview-target="banner-@(index)-text">@Model.Banners[index].Text</p>
                                <span class="btn btn-outline-primary" data-preview-target="banner-@(index)-button">@Model.Banners[index].ButtonText</span>
                            </article>
                        }
                    </div>
                    <p class="mt-3 mb-1">Pie de página</p>
                    <div class="personalization-preview__footer" data-preview-target="footer-text">@Model.FooterText</div>
                    <p class="form-text mt-3">La previsualización no publica los cambios; se aplican al guardar.</p>
                </section>

                <section class="admin-panel-card mb-4" aria-labelledby="logo-settings-title">
                    <h2 id="logo-settings-title">Logo y decoración</h2>
                    @if (!string.IsNullOrEmpty(Model.LogoImagePath) && Url.IsLocalUrl(Model.LogoImagePath))
                    {
                        <img src="@Model.LogoImagePath" class="admin-image-preview mb-3" alt="Logo actual" data-preview-image="logo" />
                    }
                    else
                    {
                        <div class="admin-image-preview-placeholder mb-3" data-preview-image="logo">Logo de texto HOCICOS A.J.</div>
                    }
                    <div class="mb-3">
                        <label asp-for="LogoFile" class="form-label">Reemplazar logo</label>
                        <input asp-for="LogoFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control" data-image-input="logo" />
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="RemoveLogoImage" class="form-check-input" />
                        <label asp-for="RemoveLogoImage" class="form-check-label">Usar logo de texto</label>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.DashboardImagePath) && Url.IsLocalUrl(Model.DashboardImagePath))
                    {
                        <img src="@Model.DashboardImagePath" class="admin-image-preview mb-3" alt="Decoración actual del panel" data-preview-image="dashboard" />
                    }
                    else
                    {
                        <div class="admin-image-preview-placeholder mb-3" data-preview-image="dashboard">Decoración predeterminada</div>
                    }
                    <div class="mb-3">
                        <label asp-for="DashboardFile" class="form-label">Imagen decorativa del panel</label>
                        <input asp-for="DashboardFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control" data-image-input="dashboard" />
                    </div>
                    <div class="form-check">
                        <input asp-for="RemoveDashboardImage" class="form-check-input" />
                        <label asp-for="RemoveDashboardImage" class="form-check-label">Usar decoración predeterminada</label>
                    </div>
                    <p class="form-text mt-3">Tamaño máximo: @(ViewData["MaximumImageSizeMb"] ?? 5) MB por imagen. Se verifica el contenido, no solo el nombre del archivo.</p>
                </section>

                <section class="admin-panel-card mb-4" aria-labelledby="category-image-title">
                    <h2 id="category-image-title">Imágenes de categorías</h2>
                    @if (Model.Categories.Count == 0)
                    {
                        <p>No hay categorías registradas.</p>
                    }
                    @for (var index = 0; index < Model.Categories.Count; index++)
                    {
                        <div class="category-image-editor">
                            <input asp-for="Categories[index].Id" type="hidden" />
                            <p><strong>@Model.Categories[index].Name</strong></p>
                            @if (!string.IsNullOrEmpty(Model.Categories[index].ImagePath) && Url.IsLocalUrl(Model.Categories[index].ImagePath))
                            {
                                <img src="@Model.Categories[index].ImagePath" class="admin-image-preview mb-2" alt="Imagen de @Model.Categories[index].Name" data-preview-image="category-@Model.Categories[index].Id" />
                            }
                            else
                            {
                                <div class="admin-image-preview-placeholder mb-2" data-preview-image="category-@Model.Categories[index].Id">Sin imagen</div>
                            }
                            <label asp-for="Categories[index].ImageFile" class="form-label">Reemplazar imagen</label>
                            <input asp-for="Categories[index].ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control" data-image-input="category-@Model.Categories[index].Id" />
                            <div class="form-check mt-2">
                                <input asp-for="Categories[index].RemoveImage" class="form-check-input" />
                                <label asp-for="Categories[index].RemoveImage" class="form-check-label">Quitar imagen</label>
                            </div>
                        </div>
                    }
                </section>

                <section class="admin-panel-card mb-4" aria-labelledby="featured-products-title">
                    <h2 id="featured-products-title">Productos destacados</h2>
                    <p class="text-muted">Seleccione productos activos con stock. Si no selecciona ninguno, la tienda muestra productos disponibles.</p>
                    @if (Model.Products.Count == 0)
                    {
                        <p>No hay productos disponibles para destacar.</p>
                    }
                    @for (var index = 0; index < Model.Products.Count; index++)
                    {
                        <div class="form-check">
                            <input asp-for="Products[index].Id" type="hidden" />
                            <input asp-for="Products[index].Name" type="hidden" />
                            <input asp-for="Products[index].Selected" class="form-check-input" />
                            <label asp-for="Products[index].Selected" class="form-check-label">@Model.Products[index].Name</label>
                        </div>
                    }
                </section>
            </div>
        </div>

        <div class="personalization-actions">
            <button type="submit" class="btn btn-primary btn-lg">Guardar personalización</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll("[data-live-preview]").forEach((input) => {
            input.addEventListener("input", () => {
                document.querySelectorAll(`[data-preview-target="${input.dataset.livePreview}"]`)
                    .forEach((target) => { target.textContent = input.value; });
            });
        });

        const previewUrls = new Map();
        document.querySelectorAll("[data-image-input]").forEach((input) => {
            input.addEventListener("change", () => {
                const preview = document.querySelector(`[data-preview-image="${input.dataset.imageInput}"]`);
                const file = input.files && input.files[0];
                if (!preview || !file) return;
                const previousUrl = previewUrls.get(input.dataset.imageInput);
                if (previousUrl) URL.revokeObjectURL(previousUrl);
                const imageUrl = URL.createObjectURL(file);
                previewUrls.set(input.dataset.imageInput, imageUrl);
                if (preview instanceof HTMLImageElement) {
                    preview.src = imageUrl;
                } else {
                    const image = document.createElement("img");
                    image.className = preview.className;
                    image.alt = "Previsualización local";
                    image.dataset.previewImage = input.dataset.imageInput;
                    image.src = imageUrl;
                    preview.replaceWith(image);
                }
            });
        });

        document.querySelectorAll("[data-banner-active]").forEach((input) => {
            const preview = document.querySelector(`[data-banner-preview="${input.dataset.bannerActive}"]`);
            if (!preview) return;
            const updateVisibility = () => { preview.hidden = !input.checked; };
            input.addEventListener("change", updateVisibility);
            updateVisibility();
        });
    </script>
}
