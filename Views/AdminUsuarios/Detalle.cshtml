@model UsuarioAdminDetalleViewModel

@{
    ViewData["Title"] = $"Usuario {Model.Id}";
}

<div class="container mt-4">
    <h2>Detalle de usuario</h2>

    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
        <dt class="col-sm-3">Nombre de usuario</dt>
        <dd class="col-sm-9">@(Model.Usuario ?? "—")</dd>
        <dt class="col-sm-3">Rol</dt>
        <dd class="col-sm-9">@Model.Rol</dd>
        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@(Model.Correo ?? "—")</dd>
        <dt class="col-sm-3">Teléfono</dt>
        <dd class="col-sm-9">@(Model.Telefono ?? "—")</dd>
        <dt class="col-sm-3">Dirección</dt>
        <dd class="col-sm-9">@(Model.Direccion ?? "—")</dd>
    </dl>

    <a asp-action="Index" class="btn btn-secondary">Volver a usuarios</a>
</div>
