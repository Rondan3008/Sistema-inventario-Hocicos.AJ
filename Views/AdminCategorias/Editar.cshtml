@model CategoriaFormViewModel

@{
    ViewData["Title"] = "Editar categoría";
}

<div class="container mt-4">
    <h2>Editar categoría</h2>
    <form asp-action="Editar" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" asp-antiforgery="true">
        <partial name="_FormularioCampos" model="Model" />
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
