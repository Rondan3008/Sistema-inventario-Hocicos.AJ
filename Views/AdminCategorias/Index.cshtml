@model IEnumerable<HocicosAJ.Models.Database.Categorium>

@{
    ViewData["Title"] = "Administrar categorías";
}

<div class="container mt-4">
    <h2>Administración de categorías</h2>
    <partial name="_Mensajes" />
    <a asp-action="Crear" class="btn btn-primary mb-3">Registrar categoría</a>
    <a asp-controller="AdminProductos" asp-action="Index" class="btn btn-secondary mb-3">Administrar productos</a>

    <div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Categoría</th>
                <th>Descripción</th>
                <th>Productos asociados</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Idcategoria</td>
                    <td>@categoria.NombreCategoria</td>
                    <td>@categoria.Descripcion</td>
                    <td>@categoria.Productos.Count</td>
                    <td>@(categoria.Activo ? "Activo" : "Inactivo")</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@categoria.Idcategoria" class="btn btn-secondary btn-sm">Editar</a>
                        @if (categoria.Activo)
                        {
                            <form asp-action="Desactivar" asp-route-id="@categoria.Idcategoria" method="post" class="d-inline" onsubmit="return confirm('¿Desea desactivar esta categoría?');">
                                <button type="submit" class="btn btn-secondary btn-sm">Desactivar</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar" asp-route-id="@categoria.Idcategoria" method="post" class="d-inline" onsubmit="return confirm('¿Desea reactivar esta categoría?');">
                                <button type="submit" class="btn btn-secondary btn-sm">Reactivar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center">No hay categorías registradas.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
