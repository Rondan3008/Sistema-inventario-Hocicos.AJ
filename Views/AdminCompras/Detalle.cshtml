@model HocicosAJ.Models.ViewModels.AdminCompraDetalleViewModel

@{
    ViewData["Title"] = $"Pedido {Model.Id}";
}

<div class="container mt-4">
    <div class="no-print">
        <button type="button" class="btn btn-primary" onclick="window.print()">Imprimir resumen</button>
    </div>
    <section class="print-area">
    <h1>Pedido #@Model.Id</h1>
    <p><strong>Cliente:</strong> @Model.ClienteNombre (@(Model.ClienteUsuario ?? "—"))</p>
    <p><strong>Fecha:</strong> @Model.Fecha.ToString("g")</p>
    <p><strong>Estado:</strong> @Model.Estado</p>
    <p><strong>Total registrado:</strong> Bs @Model.Total.ToString("N2")</p>
    <p>Este resumen no es un comprobante fiscal ni confirma que el pago se haya recibido.</p>

    <div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Talla</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model.Detalles)
            {
                <tr>
                    <td>@detalle.Producto</td>
                    <td>@detalle.Talla</td>
                    <td>@detalle.Cantidad</td>
                    <td>Bs @detalle.PrecioUnitario.ToString("N2")</td>
                    <td>Bs @detalle.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    </section>

    <a asp-controller="AdminComprobantes" asp-action="Index" asp-route-compraId="@Model.Id" class="btn btn-secondary no-print">Ver comprobantes</a>
    <a asp-action="Index" class="btn btn-secondary no-print">Volver a pedidos</a>
</div>
